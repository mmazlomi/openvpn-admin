#!/usr/bin/env bash
#
# ovpn-helper — the ONLY privileged entry point for the OpenVPN admin panel.
#
# The panel runs as the unprivileged `openvpn-admin` user and invokes this
# script through a locked-down sudoers rule:
#
#   openvpn-admin ALL=(root) NOPASSWD: /opt/openvpn-admin/bin/ovpn-helper
#
# Every sub-command re-validates its arguments here, independently of the
# Node layer. This keeps the EasyRSA PKI 100% root-owned: no world- or
# group-readable private keys, no chmod of /etc/openvpn.
#
# Sub-commands:
#   build   <name>     build-client-full <name> nopass
#   revoke  <name>     revoke <name> ; gen-crl
#   gen-crl            regenerate the CRL
#   read-ca            print pki/ca.crt (PEM)
#   read-ta            print the tls-crypt/tls-auth key
#   read-cert <name>   print pki/issued/<name>.crt (PEM)
#   read-key  <name>   print pki/private/<name>.key (PEM)
#   read-index        print pki/index.txt
#   pki-status <name>  print "req=0/1 cert=0/1 key=0/1"
#   crl-status        print "mtime=<epoch> size=<bytes>" for pki/crl.pem
#   set-ip <name> <ip> [mask]  write client CCD file with ifconfig-push
#   delete-ip <name>   remove client CCD file
#   read-ip <name>     print assigned static IP from CCD file
#
set -euo pipefail
umask 077

CONF=/etc/openvpn-admin/helper.conf
EASYRSA_DIR=/etc/openvpn/easy-rsa
CERT_DAYS=825
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

PKI_DIR="${PKI_DIR:-$EASYRSA_DIR/pki}"
EASYRSA_BIN="${EASYRSA_BIN:-$EASYRSA_DIR/easyrsa}"
CA_PASS_FILE="${CA_PASS_FILE:-$EASYRSA_DIR/ca.pass}"
CCD_DIR="${CCD_DIR:-/etc/openvpn/ccd}"

die() { echo "helper-error: $*" >&2; exit 1; }

valid_name() {
  [[ "$1" =~ ^[a-zA-Z0-9_-]{1,64}$ ]] || die "invalid client name"
  case "$1" in
    ca|server|ta|dh|crl|.|..) die "reserved name" ;;
  esac
}

valid_ip() {
  local ip="$1"
  [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "invalid ip format"
  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
  for o in "$o1" "$o2" "$o3" "$o4"; do
    (( o >= 0 && o <= 255 )) || die "ip octet out of range: $o"
  done
}

easyrsa_args=(--batch "--pki=$PKI_DIR")
if [ -r "$CA_PASS_FILE" ]; then
  easyrsa_args+=("--passin=file:$CA_PASS_FILE")
fi

run_easyrsa() {
  cd "$EASYRSA_DIR"
  "$EASYRSA_BIN" "${easyrsa_args[@]}" "$@"
}

cmd="${1:-}"; shift || true

case "$cmd" in
  build)
    name="${1:-}"; valid_name "$name"
    [ -e "$PKI_DIR/issued/$name.crt" ] && die "certificate already exists"
    run_easyrsa "--days=$CERT_DAYS" build-client-full "$name" nopass
    [ -s "$PKI_DIR/issued/$name.crt" ] || die "certificate not created"
    [ -s "$PKI_DIR/private/$name.key" ] || die "private key not created"
    echo "ok"
    ;;

  revoke)
    name="${1:-}"; valid_name "$name"
    [ -e "$PKI_DIR/issued/$name.crt" ] || die "no such issued certificate"
    run_easyrsa revoke "$name"
    run_easyrsa gen-crl
    [ -s "$PKI_DIR/crl.pem" ] || die "CRL not generated"
    echo "ok"
    ;;

  gen-crl)
    run_easyrsa gen-crl
    [ -s "$PKI_DIR/crl.pem" ] || die "CRL not generated"
    echo "ok"
    ;;

  read-ca)
    cat "$PKI_DIR/ca.crt"
    ;;

  read-ta)
    # Follows the symlink to /etc/openvpn/server/ta.key when present.
    ta="$PKI_DIR/ta.key"
    [ -e "$ta" ] || ta=/etc/openvpn/server/ta.key
    cat "$ta"
    ;;

  read-cert)
    name="${1:-}"; valid_name "$name"
    cat "$PKI_DIR/issued/$name.crt"
    ;;

  read-key)
    name="${1:-}"; valid_name "$name"
    cat "$PKI_DIR/private/$name.key"
    ;;

  read-index)
    cat "$PKI_DIR/index.txt"
    ;;

  pki-status)
    name="${1:-}"; valid_name "$name"
    r=0; c=0; k=0
    [ -e "$PKI_DIR/reqs/$name.req" ] && r=1
    [ -e "$PKI_DIR/issued/$name.crt" ] && c=1
    [ -e "$PKI_DIR/private/$name.key" ] && k=1
    echo "req=$r cert=$c key=$k"
    ;;

  crl-status)
    f="$PKI_DIR/crl.pem"
    if [ -e "$f" ]; then
      echo "mtime=$(stat -c %Y "$f") size=$(stat -c %s "$f")"
    else
      echo "mtime=0 size=0"
    fi
    ;;

  set-ip)
    name="${1:-}"; valid_name "$name"
    ip="${2:-}"; valid_ip "$ip"
    netmask="${3:-255.255.255.0}"; valid_ip "$netmask"
    mkdir -p "$CCD_DIR"
    was_disabled=0
    if [ -f "$CCD_DIR/$name" ] && grep -q "^disable" "$CCD_DIR/$name"; then
      was_disabled=1
    fi
    printf "ifconfig-push %s %s\n" "$ip" "$netmask" > "$CCD_DIR/$name"
    [ "$was_disabled" -eq 1 ] && printf "disable\n" >> "$CCD_DIR/$name"
    chmod 644 "$CCD_DIR/$name"
    echo "ok"
    ;;

  delete-ip)
    name="${1:-}"; valid_name "$name"
    if [ -f "$CCD_DIR/$name" ]; then
      if grep -q "^disable" "$CCD_DIR/$name"; then
        printf "disable\n" > "$CCD_DIR/$name"
        chmod 644 "$CCD_DIR/$name"
      else
        rm -f "$CCD_DIR/$name"
      fi
    fi
    echo "ok"
    ;;

  pause-client)
    name="${1:-}"; valid_name "$name"
    mkdir -p "$CCD_DIR"
    ccd_file="$CCD_DIR/$name"
    if [ -f "$ccd_file" ]; then
      if ! grep -q "^disable" "$ccd_file"; then
        printf "\ndisable\n" >> "$ccd_file"
      fi
    else
      printf "disable\n" > "$ccd_file"
    fi
    chmod 644 "$ccd_file"
    echo "ok"
    ;;

  resume-client)
    name="${1:-}"; valid_name "$name"
    ccd_file="$CCD_DIR/$name"
    if [ -f "$ccd_file" ]; then
      sed -i '/^disable/d' "$ccd_file"
      if ! grep -q '[^[:space:]]' "$ccd_file"; then
        rm -f "$ccd_file"
      else
        chmod 644 "$ccd_file"
      fi
    fi
    echo "ok"
    ;;

  read-ip)
    name="${1:-}"; valid_name "$name"
    if [ -f "$CCD_DIR/$name" ]; then
      awk '/^ifconfig-push / {print $2}' "$CCD_DIR/$name"
    fi
    ;;

  delete-client)
    name="${1:-}"; valid_name "$name"
    if [ -e "$PKI_DIR/issued/$name.crt" ]; then
      run_easyrsa revoke "$name" || true
      run_easyrsa gen-crl || true
    fi
    rm -f "$PKI_DIR/issued/$name.crt" \
          "$PKI_DIR/private/$name.key" \
          "$PKI_DIR/reqs/$name.req" \
          "$CCD_DIR/$name"
    echo "ok"
    ;;

  renew)
    name="${1:-}"; valid_name "$name"
    days="${2:-$CERT_DAYS}"
    [[ "$days" =~ ^[0-9]+$ ]] || die "invalid days parameter"
    [ -e "$PKI_DIR/issued/$name.crt" ] || die "no issued certificate found"
    run_easyrsa "--days=$days" renew "$name"
    [ -s "$PKI_DIR/issued/$name.crt" ] || die "renewed certificate missing"
    echo "ok"
    ;;

  *)
    die "unknown sub-command: ${cmd:-<none>}"
    ;;
esac

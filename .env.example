# Copy to /etc/openvpn-admin.env (chmod 600) for production, or to .env for
# local development. Never commit real secrets.

NODE_ENV=production

# The app MUST listen only on loopback; nginx terminates TLS in front of it.
HOST=127.0.0.1
PORT=8282

# openssl rand -hex 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_MAX_AGE_MS=28800000
# true once served over HTTPS (directly or via a trusted proxy sending
# X-Forwarded-Proto). Keep false for plain-HTTP local testing.
COOKIE_SECURE=true
TRUST_PROXY=true

# --- EasyRSA / PKI (existing installation, do not recreate) ---
EASYRSA_DIR=/etc/openvpn/easy-rsa
PKI_DIR=/etc/openvpn/easy-rsa/pki
EASYRSA_BIN=/etc/openvpn/easy-rsa/easyrsa
EASYRSA_PASS_FILE=/etc/openvpn/easy-rsa/ca.pass

# Privileged helper (runs easyrsa / reads PEM files as root via sudo)
HELPER_BIN=/opt/openvpn-admin/bin/ovpn-helper
SUDO_BIN=/usr/bin/sudo
# Set true only when the panel itself runs as root (no sudo hop).
HELPER_NO_SUDO=false

# --- OpenVPN server facts (used to build .ovpn files) ---
OPENVPN_HOST=ppp.mmazlomi.ir
OPENVPN_PORT=1194
OPENVPN_PROTOCOL=udp
VPN_NETWORK=10.8.0.0/24

# Management interface for live connection status (read-only)
OPENVPN_MGMT_HOST=127.0.0.1
OPENVPN_MGMT_PORT=8989
OPENVPN_MGMT_ENABLED=true

# TLS control-channel key for the inline <tls-crypt>/<tls-auth> block.
# 'auto' inspects server.conf; override with 'tls-crypt' or 'tls-auth'.
TLS_MODE=auto
TLS_KEY_FILE=/etc/openvpn-admin/tls-crypt.key
OPENVPN_SERVER_CONF=/etc/openvpn/server/server.conf

# --- Storage ---
DATABASE=/var/lib/openvpn-admin/openvpn-admin.db

# --- Certificate lifetime ---
CLIENT_CERT_DAYS=825

# --- Login rate limiting ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

LOG_LEVEL=info
